PORT=4000
DATABASE_URL=postgresql://user:password@localhost:5432/product_intel?schema=public
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key
AWS_S3_BUCKET=your_bucket_name
# Optional: public base URL for S3 objects (eg. https://cdn.example.com)
AWS_S3_PUBLIC_BASE_URL=
# Worker settings
WORKER_SHARED_TOKEN=change_me_to_secure_token
# Whether the API should run Playwright itself (true/false). In production set to false.
PLAYWRIGHT_ENABLED=false
