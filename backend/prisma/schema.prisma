generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AnalysisStatus {
  queued
  running
  completed
  failed
}

model Analysis {
  id              String         @id @default(uuid())
  url             String
  normalizedUrl   String
  domain          String
  status          AnalysisStatus @default(queued)
  errorMessage    String?        
  summaryJson     Json?
  productMapJson  Json?
  flowsJson       Json?
  apiMapJson      Json?
  uxInsightsJson  Json?
  userStoriesMd   String?        @db.Text
  flowsMd         String?        @db.Text
  prdMd           String?        @db.Text
  uxInsightsMd    String?        @db.Text
  screenshotsJson Json?
  startedAt       DateTime?
  completedAt     DateTime?
  durationMs      Int?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([status, createdAt])
}
